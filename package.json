{
  "name": "tutor-mx-documentation",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run docs:compile && vite",
    "build": "npm run docs:compile && tsc -b && vite build",
    "preview": "vite preview",
    "docs:compile": "node scripts/compile-content.mjs",
    "validate": "npm run docs:compile && node scripts/validate-content.mjs && node scripts/validate-site.mjs",
    "docs:openapi": "node scripts/build-openapi.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "marked": "^17.0.5"
  }
}
